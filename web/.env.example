# Copy to web/.env.local (dev) or web/.env.production.local (deploy).

# Firebase web config (Firebase console → Project settings → Your apps).
# Leave empty for single-device mode (data stays in this browser, no API).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Browser key: Maps JavaScript API only, restricted to your site's HTTP referrer.
VITE_GOOGLE_MAPS_BROWSER_KEY=
VITE_GOOGLE_MAPS_MAP_ID=

# Optional: call the API somewhere other than same-origin /api (rarely needed).
# VITE_API_BASE=
