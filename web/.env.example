# Cloudflare Worker base URL (no trailing slash). Leave empty to run without the API:
# short Google Maps links then can't be expanded and travel times are estimates.
VITE_API_BASE=

# Browser key: Maps JavaScript API only, restricted to your site's HTTP referrer.
VITE_GOOGLE_MAPS_BROWSER_KEY=
VITE_GOOGLE_MAPS_MAP_ID=

# Firebase web config. Leave empty for single-device mode (data stays in this browser).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
