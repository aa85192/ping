rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isMember(tripId) {
      return signedIn() && request.auth.uid in get(/databases/$(database)/documents/trips/$(tripId)).data.members;
    }

    match /trips/{tripId} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.members == [request.auth.uid];
      // Members edit everything except who owns the trip.
      allow update: if signedIn() && request.auth.uid in resource.data.members
        && request.resource.data.ownerUid == resource.data.ownerUid;
      // Joining: a non-member may only add themselves, and only with the invite code.
      allow update: if signedIn()
        && !(request.auth.uid in resource.data.members)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'lastJoinCode', 'memberProfiles'])
        && request.resource.data.lastJoinCode == resource.data.inviteCode
        && request.resource.data.members.hasAll(resource.data.members)
        && request.resource.data.members.size() == resource.data.members.size() + 1
        && request.auth.uid in request.resource.data.members;
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;

      match /{sub}/{docId} {
        allow read, write: if sub in ['cards', 'bookings', 'expenses'] && isMember(tripId);
      }

      // 票券夾: file metadata. Private files are visible to their owner only.
      match /files/{fileId} {
        allow read: if isMember(tripId) && (resource.data.private == false || resource.data.ownerUid == request.auth.uid);
        allow create: if isMember(tripId) && request.resource.data.ownerUid == request.auth.uid && request.resource.data.private is bool;
        allow update: if isMember(tripId) && resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == resource.data.ownerUid;
        allow delete: if isMember(tripId) && resource.data.ownerUid == request.auth.uid;
      }
    }
  }
}
